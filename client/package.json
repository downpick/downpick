{
  "name": "downpick-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "copy-monaco": "node -e \"const {cpSync}=require('fs');cpSync('node_modules/monaco-editor/min/vs','public/vs',{recursive:true,force:true})\"",
    "postinstall": "npm run copy-monaco",
    "dev": "vite",
    "prebuild": "npm run copy-monaco",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.11.2",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.8.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
