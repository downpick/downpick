{
  "version": "0.2.0",
  "configurations": [
    {
      // Debugs the Electron main process. Run `npm run dev:client` and `npm run dev:main`
      // first (or just `npm run dev` and use "Attach to Main Process" instead).
      "name": "Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "args": [".", "--dev-server=http://localhost:5173"],
      "outputCapture": "std",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "outFiles": ["${workspaceFolder}/.electron-out/**/*.js"]
    },
    {
      "name": "Attach to Main Process",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "outFiles": ["${workspaceFolder}/.electron-out/**/*.js"]
    }
  ]
}
